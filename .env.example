# pandagent — environment variable reference
# pandagent currently uses hardcoded defaults; no .env is required to run.
# Set these to override the defaults without editing panda_client.py.

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Base URL of the OpenAI-compatible inference server (llama-swap default)
LLM_BASE_URL=http://localhost:8081

# Default model used when no task-specific override exists in TASK_MODEL_MAP
LLM_DEFAULT_MODEL=qwen3:14b
